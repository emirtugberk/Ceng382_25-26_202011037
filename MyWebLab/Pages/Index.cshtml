@page
@model Ceng382_25_26_202011037.Pages.IndexModel
@using System
@{
    ViewData["Title"] = "Class Information";
    Func<int,string> MakeUrl = p => {
        var url = $"/Index?page={p}";
        if(!string.IsNullOrEmpty(Model.SearchTerm))
            url += $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}";
        foreach(var col in Model.SelectedColumns)
            url += $"&selectedColumns={Uri.EscapeDataString(col)}";
        return url;
    };
    var headers = new[] { "ClassName", "StudentCount", "Description" };
}
<style>
  #dataTable th.selected-col,
  #dataTable td.selected-col {
    background-color: #fffae6 !important;
  }
</style>

<h2>@ViewData["Title"]</h2>

<form method="get" class="mb-3">
  <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Ara..." class="form-control d-inline-block w-25" />
  @foreach(var col in Model.SelectedColumns){
    <input type="hidden" name="selectedColumns" value="@col" />
  }
  <button class="btn btn-primary">Filtrele</button>
</form>

<table id="dataTable" class="table table-striped">
  <thead>
    <tr>
      @foreach(var header in headers){
        var sel = Model.SelectedColumns.Contains(header);
        <th class="@(sel ? "selected-col" : "")">
          <input type="checkbox" name="selectedColumns" value="@header" @(sel ? "checked" : "") />
          @header
        </th>
      }
    </tr>
  </thead>
  <tbody>
    @foreach(var item in Model.Items){
      <tr>
        @foreach(var header in headers){
          if(!Model.SelectedColumns.Any() || Model.SelectedColumns.Contains(header)){
            var val = item.GetType().GetProperty(header)?.GetValue(item);
            <td class="@(Model.SelectedColumns.Contains(header) ? "selected-col" : "")">@val</td>
          }
        }
      </tr>
    }
  </tbody>
</table>

<nav aria-label="Page nav" class="mt-3">
  <ul class="pagination">
    @for(int p=1;p<=Model.TotalPages;p++){
      <li class="page-item me-1 @(p==Model.Page?"active":"")">
        <a class="page-link" href="@MakeUrl(p)">@p</a>
      </li>
    }
  </ul>
</nav>

<div class="mt-3">
  @{ var baseUrl = MakeUrl(Model.Page); }
  <a class="btn btn-outline-secondary" href="@($"{baseUrl}&filtered=false")">Unfiltered JSON</a>
  <a class="btn btn-outline-primary" href="@($"{baseUrl}&filtered=true")">Filtered JSON</a>
</div>

<script>
  console.log('👉 Script loaded, checkboxes:', document.querySelectorAll('#dataTable thead th input[type=checkbox]').length);
  (function(){
    var table = document.getElementById('dataTable');
    if(!table) return;
    var headers = table.querySelectorAll('thead th input[type=checkbox]');
    headers.forEach(function(chk, idx){
      chk.addEventListener('change', function(){
        console.log('🔔 Checkbox changed for col', idx, 'checked=', this.checked);
        var th = this.closest('th');
        th.classList.toggle('selected-col', this.checked);
        table.querySelectorAll('tbody tr').forEach(function(tr){
          var cell = tr.children[idx];
          if(cell) cell.classList.toggle('selected-col', chk.checked);
        });
      });
    });
  })();
</script>
